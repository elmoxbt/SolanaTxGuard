# Live transactions are currently locked to devnet regardless of this
# setting (see MAINNET_ENABLED in src/live/network.ts) — mainnet support
# is built but intentionally switched off for now.
VITE_NETWORK=devnet

# Optional. Public RPC endpoints (the clusterApiUrl() fallback) are rate-
# limited and can be flaky. For anything beyond quick testing, get a free
# or paid endpoint from a provider like Helius, Triton, or QuickNode and
# set it here.
VITE_RPC_ENDPOINT=
VITE_DEVNET_RPC_ENDPOINT=
